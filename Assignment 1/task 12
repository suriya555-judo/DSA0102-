#include <iostream>
#include <array>
using namespace std;

enum class Zone {
    Inner = 0,
    Middle = 1,
    Outer = 2,
    Airport = 3
};

constexpr array<long long, 4> BASE_FARE = {
    1000, 2000, 3000, 6000
};

constexpr long long MIN_BALANCE = 5000;
constexpr int PEAK_PERCENT = 20;
constexpr int WEEKEND_DISCOUNT = 10;

class MonthlyPass {
private:
    bool active;
    Zone zone1, zone2;

public:
    MonthlyPass(bool a, Zone z1, Zone z2) {
        active = a;
        zone1 = z1;
        zone2 = z2;
    }

    bool covers(Zone z) const {
        return active && (z == zone1 || z == zone2);
    }
};

class SmartCard {
private:
    long long balance;

public:
    SmartCard(long long b) {
        balance = b;
    }

    bool pay(long long fare) {
        if (fare < 0 || balance - fare < MIN_BALANCE) {
            return false;
        }

        balance -= fare;
        return true;
    }

    long long getBalance() const {
        return balance;
    }
};

long long calculateFare(Zone zone, int hour,
                        bool weekend, const MonthlyPass& pass) {

    if (pass.covers(zone)) {
        return 0;
    }

    int index = static_cast<int>(zone);

    if (index < 0 || index >= 4) {
        return -1;
    }

    long long fare = BASE_FARE[index];

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (weekend) {
        fare -= fare * WEEKEND_DISCOUNT / 100;
    }
    else if (peak) {
        fare += fare * PEAK_PERCENT / 100;
    }

    return fare;
}

int main() {
    MonthlyPass pass(true, Zone::Inner, Zone::Middle);
    SmartCard card(20000);

    struct Trip {
        Zone zone;
        int hour;
        bool weekend;
    };

    Trip trips[] = {
        {Zone::Airport, 9, false},
        {Zone::Outer, 18, true},
        {Zone::Inner, 12, false}
    };

    for (const Trip& t : trips) {
        long long fare = calculateFare(
            t.zone, t.hour, t.weekend, pass
        );

        if (fare < 0) {
            cout << "Invalid zone" << endl;
        }
        else if (card.pay(fare)) {
            cout << "Fare: " << fare << " paise" << endl;
            cout << "Balance: "
                 << card.getBalance() << " paise" << endl;
        }
        else {
            cout << "Journey denied" << endl;
        }
    }

    return 0;
}
