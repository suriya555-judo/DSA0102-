#include <iostream>
#include <string>
using namespace std;

class SmartCard {
private:
    long long balance;

public:
    SmartCard(long long b) {
        balance = b;
    }

    bool canPay(long long fare) {
        return balance - fare >= 5000;
    }

    bool deduct(long long fare) {
        if (canPay(fare)) {
            balance -= fare;
            return true;
        }
        return false;
    }

    long long getBalance() {
        return balance;
    }
};

class Passenger {
public:
    string name;
    string category;

    Passenger(string n, string c) {
        name = n;
        category = c;
    }
};

class Journey {
public:
    int fromStation, toStation;

    Journey(int f, int t) {
        fromStation = f;
        toStation = t;
    }
};

int main() {
    Passenger p("Arun", "Regular");
    Journey j(1, 5);
    SmartCard card(10000);

    cout << "Passenger: " << p.name << endl;
    cout << "Category: " << p.category << endl;
    cout << "Journey: " << j.fromStation << " to " << j.toStation << endl;

    if (card.deduct(2000))
        cout << "Journey approved\n";
    else
        cout << "Journey denied\n";

    cout << "Balance: " << card.getBalance() << " paise\n";

    return 0;
}
