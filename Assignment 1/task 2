#include <iostream>
using namespace std;

enum class Zone {
    Inner, Middle, Outer
};

constexpr long long INNER_FARE = 1000;
constexpr long long MIDDLE_FARE = 2000;
constexpr long long OUTER_FARE = 3000;

constexpr int PEAK_SURCHARGE = 20;
constexpr long long MIN_BALANCE = 5000;

int main() {
    Zone selectedZone = Zone::Middle;
    long long fare = 0;

    switch (selectedZone) {
        case Zone::Inner:
            fare = INNER_FARE;
            break;

        case Zone::Middle:
            fare = MIDDLE_FARE;
            break;

        case Zone::Outer:
            fare = OUTER_FARE;
            break;
    }

    cout << "Base fare: " << fare << " paise" << endl;
    cout << "Peak surcharge: " << PEAK_SURCHARGE << "%" << endl;
    cout << "Minimum balance: " << MIN_BALANCE << " paise" << endl;

    return 0;
}
