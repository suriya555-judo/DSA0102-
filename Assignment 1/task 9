#include <iostream>
using namespace std;

enum class Zone {
    Inner, Middle, Outer
};

long long calculateFare(Zone zone, int hour) {
    long long base = 0;

    switch (zone) {
        case Zone::Inner:
            base = 1000;
            break;

        case Zone::Middle:
            base = 2000;
            break;

        case Zone::Outer:
            base = 3000;
            break;
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (peak) {
        base += base * 20 / 100;
    }

    return base;
}

int main() {
    struct Test {
        Zone zone;
        int hour;
        long long expected;
    };

    Test tests[] = {
        {Zone::Inner, 11, 1000},
        {Zone::Middle, 9, 2400},
        {Zone::Outer, 12, 3000},
        {Zone::Inner, 8, 1200},
        {Zone::Inner, 10, 1000},
        {Zone::Outer, 17, 3600},
        {Zone::Outer, 20, 3000}
    };

    int passed = 0;

    for (const Test& t : tests) {
        long long actual = calculateFare(t.zone, t.hour);

        if (actual == t.expected) {
            cout << "PASS: ";
            passed++;
        }
        else {
            cout << "FAIL: ";
        }

        cout << "Expected " << t.expected
             << ", Actual " << actual << endl;
    }

    cout << "Passed tests: " << passed << endl;

    long long balance = 6000;
    long long fare = 1000;

    cout << boolalpha;
    cout << "Exactly Rs.50 remains: "
         << (balance - fare == 5000) << endl;

    return 0;
}
