#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;

int main() {
    int hour;
    long long balance;

    cout << "Enter hour (0-23): ";

    while (!(cin >> hour) || hour < 0 || hour > 23) {
        cout << "Invalid hour. Enter again: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    cout << "Enter balance in paise: ";

    while (!(cin >> balance) || balance < 0) {
        cout << "Invalid balance. Enter again: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    cout << boolalpha;
    cout << "Peak hour: " << peak << endl;

    cout << fixed << setprecision(2);
    cout << "Balance Rs: " << balance / 100.0 << endl;

    return 0;
}
