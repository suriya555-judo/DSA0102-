int main() {
    int marks[] = {78, 91, 84, 88, 95, 73};

    int size = sizeof(marks) / sizeof(marks[0]);

    cout << "Highest mark: "
         << highestMarkReadOnly(marks, size) << '\n';

    highestMark(marks, size) += 2;

    cout << "After moderation: "
         << highestMarkReadOnly(marks, size) << '\n';

    int index = highestMarkIndex(marks, size);

    cout << "Highest mark index: " << index << '\n';
    cout << "Value using index: " << marks[index] << '\n';

    return 0;
}
