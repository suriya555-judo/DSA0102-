#include <iostream>
using namespace std;

int& highestMark(int marks[], int size) {
    int highestIndex = 0;

    for (int i = 1; i < size; ++i) {
        if (marks[i] > marks[highestIndex]) {
            highestIndex = i;
        }
    }

    return marks[highestIndex];
}

const int& highestMarkReadOnly(const int marks[], int size) {
    int highestIndex = 0;

    for (int i = 1; i < size; ++i) {
        if (marks[i] > marks[highestIndex]) {
            highestIndex = i;
        }
    }

    return marks[highestIndex];
}

int highestMarkIndex(const int marks[], int size) {
    int highestIndex = 0;

    for (int i = 1; i < size; ++i) {
        if (marks[i] > marks[highestIndex]) {
            highestIndex = i;
        }
    }

    return highestIndex;
}

// Dangerous example: never use a reference to a local variable.
// int& badReference() {
