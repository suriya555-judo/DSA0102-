#include <iostream>
#include <string>
using namespace std;

class SavingsAccount {
private:
    string accountNumber;
    double balance;

    string transactions[10];

    int count;
    int nextIndex;

    void addTransaction(const string& text) {
        transactions[nextIndex] = text;

        nextIndex = (nextIndex + 1) % 10;

        if (count < 10)
            ++count;
    }

public:
    SavingsAccount(string number, double openingBalance)
        : accountNumber(number),
          balance(openingBalance),
          count(0),
          nextIndex(0) {

        addTransaction("Opening balance: "
                       + to_string(openingBalance));
    }

    void deposit(double amount);
    void withdraw(double amount);
    void miniStatement() const;
};

void SavingsAccount::deposit(double amount) {
    if (amount <= 0) {
        cout << "Invalid deposit\n";
        return;
    }

    balance += amount;

    addTransaction("Deposit: " + to_string(amount));
}

void SavingsAccount::withdraw(double amount) {
    if (amount <= 0 || amount > balance) {
        cout << "Invalid withdrawal\n";
        return;
    }

    balance -= amount;

    addTransaction("Withdrawal: " + to_string(amount));
}

void SavingsAccount::miniStatement() const {
    cout << "\nAccount: " << accountNumber << '\n';

    cout << "Balance: " << balance << '\n';

    cout << "Last " << count << " transactions:\n";

    int start = (count == 10) ? nextIndex : 0;

    for (int i = 0; i < count; ++i) {
        int index = (start + i) % 10;

        cout << transactions[index] << '\n';
    }
}

int main() {
    SavingsAccount account("SA1001", 1000);

    account.deposit(500);
    account.withdraw(200);
    account.deposit(300);
    account.withdraw(100);
    account.deposit(50);

    account.miniStatement();

    return 0;
}
