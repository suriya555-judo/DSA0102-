#include <iostream>
using namespace std;

struct Parcel {
    double kilograms;
    bool express;
    bool insured;
};

double charge(int grams) {
    return 40.0 + (grams / 1000.0) * 20.0;
}

double charge(double kilograms,
              bool express = false,
              bool insured = false) {

    double amount = 40.0 + kilograms * 20.0;

    if (express)
        amount += 30.0;

    if (insured)
        amount += 15.0;

    return amount;
}

double charge(const Parcel& p) {
    return charge(p.kilograms, p.express, p.insured);
}

int main() {
    Parcel p{2.5, true, true};

    cout << "charge(2) = " << charge(2) << '\n';

    cout << "charge(2.0) = "
         << charge(2.0) << '\n';

    cout << "charge(2.0f) = "
         << charge(2.0f) << '\n';

    cout << "charge(2.0, true) = "
         << charge(2.0, true) << '\n';

    cout << "charge(2.0, true, true) = "
         << charge(2.0, true, true) << '\n';

    cout << "charge(parcel) = "
         << charge(p) << '\n';

    return 0;
}
