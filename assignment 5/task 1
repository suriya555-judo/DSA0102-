#include <iostream>
#include <string>
#include <vector>
#include <memory>
#include <stdexcept>
using namespace std;

class Bill {
protected:
    string patient;

public:
    explicit Bill(const string& p) : patient(p) {}
    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    string getPatient() const {
        return patient;
    }

    void print() const {
        cout << type() << " " << patient << ": " << total() << '\n';
    }
};

class OutPatient : public Bill {
    double consultation, tests;

public:
    OutPatient(const string& p, double c, double t)
        : Bill(p), consultation(c), tests(t) {
        if (c < 0 || t < 0)
            throw invalid_argument("Negative charges");
    }

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

class InPatient : public Bill {
    int days;
    double perDay, surgery;

public:
    InPatient(const string& p, int d, double rate, double s)
        : Bill(p), days(d), perDay(rate), surgery(s) {
        if (d < 0 || rate < 0 || s < 0)
            throw invalid_argument("Negative charges");
    }

    double total() const override {
        return days * perDay + surgery;
    }

    string type() const override {
        return "IP";
    }
};

class DayCareBill : public Bill {
    double packagePrice;

public:
    DayCareBill(const string& p, double price)
        : Bill(p), packagePrice(price) {
        if (price < 0)
            throw invalid_argument("Negative package price");
    }

    double total() const override {
        return packagePrice;
    }

    string type() const override {
        return "DayCare";
    }
};

class EmergencyBill : public Bill {
    double baseCharge, hourlyCharge;
    int hours;

public:
    EmergencyBill(const string& p, double base, double hourly, int h)
        : Bill(p), baseCharge(base), hourlyCharge(hourly), hours(h) {
        if (base < 0 || hourly < 0 || h < 0)
            throw invalid_argument("Negative emergency charges");
    }

    double total() const override {
        return baseCharge + hourlyCharge * hours;
    }

    string type() const override {
        return "Emergency";
    }
};

class Payer {
public:
    virtual ~Payer() = default;
    virtual double amountCovered(const Bill& bill) const = 0;
};

class SelfPay : public Payer {
public:
    double amountCovered(const Bill& bill) const override {
        return bill.total();
    }
};

class Insurance : public Payer {
    double coverLimit;
    double coPayment;

public:
    Insurance(double limit, double percentage)
        : coverLimit(limit), coPayment(percentage) {
        if (limit < 0 || percentage < 0 || percentage > 100)
            throw invalid_argument("Invalid insurance details");
    }

    double amountCovered(const Bill& bill) const override {
        double covered = min(bill.total(), coverLimit);
        return covered * (1.0 - coPayment / 100.0);
    }
};

class GovernmentScheme : public Payer {
    double packageRate;

public:
    GovernmentScheme(double rate) : packageRate(rate) {
        if (rate < 0)
            throw invalid_argument("Invalid package rate");
    }

    double amountCovered(const Bill&) const override {
        return packageRate;
    }
};

int main() {
    try {
        vector<unique_ptr<Bill>> bills;

        bills.push_back(make_unique<OutPatient>("Ravi", 500, 1200));
        bills.push_back(make_unique<InPatient>("Meena", 3, 2500, 40000));
        bills.push_back(make_unique<DayCareBill>("Arun", 25000));
        bills.push_back(make_unique<EmergencyBill>("Priya", 2000, 500, 4));

        SelfPay self;
        Insurance insurance(50000, 10);
        GovernmentScheme government(20000);

        double dailyTotal = 0;

        for (const auto& bill : bills) {
            bill->print();
            dailyTotal += bill->total();

            cout << "Self Pay: " << self.amountCovered(*bill) << '\n';
            cout << "Insurance: " << insurance.amountCovered(*bill) << '\n';
            cout << "Government: " << government.amountCovered(*bill) << "\n\n";
        }

        cout << "Daily Total: " << dailyTotal << '\n';
    }
    catch (const exception& e) {
        cerr << "Billing Error: " << e.what() << '\n';
    }

    return 0;
}
