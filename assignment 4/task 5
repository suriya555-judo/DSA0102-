#include <iomanip>
#include <iostream>
#include <string>
using namespace std;

class Cart {
private:
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;

public:
    // Add item using this pointer
    Cart& add(string item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            n++;
        }

        return *this;
    }

    // Set discount using this pointer
    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;

        for (int i = 0; i < n; ++i) {
            t += prices[i];
        }

        return t * (100 - discount) / 100;
    }

    void display() const {
        cout << "Cart Items:\n";

        for (int i = 0; i < n; ++i) {
            cout << items[i] << " - " << prices[i] << endl;
        }

        cout << "Total: " << total() << endl;
    }
};

int main() {
    // Direct object
    Cart c;
    c.add("Rice", 60).add("Dal", 120).setDiscount(10);

    cout << fixed << setprecision(2);
    cout << "Direct Object: " << c.total() << endl;

    // Pointer to object
    Cart* p = &c;
    p->add("Oil", 180);

    cout << "Pointer: " << p->total() << endl;

    // Reference to object
    Cart& ref = c;
    ref.add("Sugar", 40);

    cout << "Reference: " << ref.total() << endl;

    // Dynamic object
    Cart* dynamicCart = new Cart();

    dynamicCart->add("Milk", 50);
    dynamicCart->add("Bread", 40);

    cout << "Dynamic Object: "
         << dynamicCart->total() << endl;

    delete dynamicCart;

    // Array of pointers to Cart objects
    Cart c1, c2, c3;

    c1.add("Rice", 100);
    c2.add("Oil", 200);
    c3.add("Milk", 150);

    Cart* carts[3] = { &c1, &c2, &c3 };

    Cart* highest = carts[0];

    for (int i = 1; i < 3; i++) {
        if (carts[i]->total() > highest->total()) {
            highest = carts[i];
        }
    }

    cout << "Highest Cart Total: "
         << highest->total() << endl;

    return 0;
}
