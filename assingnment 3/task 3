#include <iostream>
#include <string>
using namespace std;

class Event {
private:
    string name;
    int rows;
    int seats;
    char** seatMap;

public:
    Event(string eventName, int r, int s)
        : name(eventName),
          rows(r > 0 ? r : 0),
          seats(s > 0 ? s : 0),
          seatMap(nullptr) {

        if (rows > 0 && seats > 0) {
            seatMap = new char*[rows];

            for (int i = 0; i < rows; i++) {
                seatMap[i] = new char[seats];

                for (int j = 0; j < seats; j++) {
                    seatMap[i][j] = 'O';
                }
            }
        }

        cout << "Event created: " << name << endl;
    }

    void bookSeat(int r, int s) {
        if (r >= 0 && r < rows && s >= 0 && s < seats) {
            if (seatMap[r][s] == 'O') {
                seatMap[r][s] = 'X';
                cout << "Seat booked successfully" << endl;
            }
            else {
                cout << "Seat already booked" << endl;
            }
        }
        else {
            cout << "Invalid seat number" << endl;
        }
    }

    void cancelSeat(int r, int s) {
        if (r >= 0 && r < rows && s >= 0 && s < seats) {
            seatMap[r][s] = 'O';
            cout << "Booking cancelled" << endl;
        }
        else {
            cout << "Invalid seat number" << endl;
        }
    }

    void display() const {
        cout << "Seat Map of " << name << endl;

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < seats; j++) {
                cout << seatMap[i][j] << " ";
            }
            cout << endl;
        }
    }

    ~Event() {
        for (int i = 0; i < rows; i++) {
            delete[] seatMap[i];
        }

        delete[] seatMap;

        cout << "Event closed: " << name << endl;
    }
};

int main() {
    Event e1("College Event", 2, 3);

    e1.bookSeat(0, 1);
    e1.display();

    {
        Event e2("Cultural Event", 2, 2);
        e2.bookSeat(1, 1);
        e2.display();
    }

    Event* e3 = new Event("Annual Day", 3, 3);

    e3->bookSeat(0, 0);
    e3->display();

    delete e3;

    return 0;
}
