#include <iostream>
#include <cstring>
using namespace std;

class Text {
private:
    char* data;

public:
    // Constructor
    Text(const char* str = "") {
        data = new char[strlen(str) + 1];
        strcpy(data, str);
    }

    // Copy constructor
    Text(const Text& other) {
        data = new char[strlen(other.data) + 1];
        strcpy(data, other.data);
    }

    // Copy assignment operator
    Text& operator=(const Text& other) {
        if (this != &other) {
            char* temp = new char[strlen(other.data) + 1];

            strcpy(temp, other.data);

            delete[] data;
            data = temp;
        }

        return *this;
    }

    // Concatenation assignment
    Text& operator+=(const Text& other) {
        char* temp = new char[strlen(data) + strlen(other.data) + 1];

        strcpy(temp, data);
        strcat(temp, other.data);

        delete[] data;
        data = temp;

        return *this;
    }

    // Addition operator
    friend Text operator+(const Text& a, const Text& b) {
        Text result(a);
        result += b;
        return result;
    }

    // Equality operator
    bool operator==(const Text& other) const {
        return strcmp(data, other.data) == 0;
    }

    // Inequality operator
    bool operator!=(const Text& other) const {
        return !(*this == other);
    }

    // Output operator
    friend ostream& operator<<(ostream& out, const Text& t) {
        out << t.data;
        return out;
    }

    // Destructor
    ~Text() {
        delete[] data;
    }
};

int main() {
    Text a("Hello ");
    Text b("World");
    Text c("!");

    Text result = a + b + c;

    cout << "Combined Text: " << result << endl;

    Text copy;
