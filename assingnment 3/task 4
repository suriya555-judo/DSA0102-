#include <iostream>
#include <iomanip>
using namespace std;

class Money {
private:
    long long paise;

public:
    Money(long long rupees = 0, int p = 0)
        : paise(rupees * 100 + p) {}

    // Addition operator
    Money operator+(const Money& other) const {
        Money result;
        result.paise = paise + other.paise;
        return result;
    }

    // Subtraction operator
    Money operator-(const Money& other) const {
        Money result;
        result.paise = paise - other.paise;
        return result;
    }

    // Addition assignment operator
    Money& operator+=(const Money& other) {
        paise += other.paise;
        return *this;
    }

    // Equality operator
    bool operator==(const Money& other) const {
        return paise == other.paise;
    }

    // Less-than operator
    bool operator<(const Money& other) const {
        return paise < other.paise;
    }

    // Output stream operator
    friend ostream& operator<<(ostream& out, const Money& m) {
        long long value = (m.paise < 0) ? -m.paise : m.paise;

        if (m.paise < 0)
            out << "-";

        out << "Rs " << value / 100 << "."
            << setw(2) << setfill('0') << value % 100;

        return out;
    }

    // Input stream operator
    friend istream& operator>>(istream& in, Money& m) {
        long long rupees;
        int p;

        in >> rupees >> p;

        if (in)
            m.paise = rupees * 100 + p;

        return in;
    }
};

int main() {
    Money a(120, 75);
    Money b(79, 25);

    Money c = a + b;

    cout << "Addition: " << c << endl;

    cout << boolalpha;
    cout << "Equal: " << (c == Money(200)) << endl;

    Money x(0, 75);
    Money y(0, 50);

    cout << "Paise Addition: " << x + y << endl;

    Money d = a - b;
    cout << "Subtraction: " << d << endl;

    a += b;
    cout << "After += : " << a << endl;

    cout << "Is a less than b? " << (a < b) << endl;

    return 0;
}
